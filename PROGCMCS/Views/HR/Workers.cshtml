@model List<PROGCMCS.Models.UserListViewModel>
@{
    ViewData["Title"] = "All Workers";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-users me-2"></i>All Workers</h2>
        <a asp-action="AddWorker" class="btn btn-primary">
            <i class="fas fa-user-plus me-1"></i>Add New Worker
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="text-center text-muted py-4">
                    <i class="fas fa-users fa-3x mb-3"></i>
                    <p>No workers found.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Department</th>
                                <th>Hourly Rate</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>@user.FirstName @user.LastName</td>
                                    <td>@user.Email</td>
                                    <td>@user.Department</td>
                                    <td>R @user.HourlyRate.ToString("F2")</td>
                                    <td>
                                        <span class="badge bg-primary">@user.Role</span>
                                    </td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="EditWorker" asp-route-userId="@user.UserId"
                                               class="btn btn-outline-primary">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form asp-action="ResetPassword" method="post" class="d-inline">
                                                <input type="hidden" name="userId" value="@user.UserId" />
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-warning"
                                                        onclick="return confirm('Reset password for @user.Email?')">
                                                    <i class="fas fa-key"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>