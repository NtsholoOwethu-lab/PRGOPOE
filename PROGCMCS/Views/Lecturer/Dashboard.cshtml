@model List<PROGCMCS.Models.LecturerClaimsListViewModel>
@{
    ViewData["Title"] = "My Claims";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-list-alt me-2"></i>My Claims</h2>
        <a asp-action="CreateClaim" class="btn btn-primary">
            <i class="fas fa-plus-circle me-1"></i>Submit New Claim
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="fas fa-file-invoice-dollar fa-3x text-muted mb-3"></i>
                <h4 class="text-muted">No Claims Submitted</h4>
                <p class="text-muted">You haven't submitted any claims yet.</p>
                <a asp-action="CreateClaim" class="btn btn-primary">Submit Your First Claim</a>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Period</th>
                                <th>Hours</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Submitted</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var claim in Model)
                            {
                                <tr>
                                    <td>@claim.Period</td>
                                    <td>@claim.TotalHours.ToString("F1")</td>
                                    <td>@claim.DisplayAmount</td>
                                    <td>
                                        <span class="badge @claim.StatusBadgeClass">@claim.Status</span>
                                    </td>
                                    <td>@claim.DisplaySubmissionDate</td>
                                    <td>
                                        <a asp-action="ClaimDetails" asp-route-id="@claim.ClaimId"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i> View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>