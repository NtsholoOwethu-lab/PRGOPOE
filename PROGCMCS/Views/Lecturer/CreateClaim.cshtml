@using PROGCMCS.Models
@model PROGCMCS.Models.MonthlyClaim
@{
    ViewData["Title"] = "CreateClaim";

    // Safely handle null ViewBag.Lecturers
    var lecturersList = ViewBag.Lecturers != null
        ? new SelectList(ViewBag.Lecturers, "LecturerId", "FullName")
        : new SelectList(Enumerable.Empty<SelectListItem>());
}

<div class="container mt-5">
    <h2 class="mb-4">Submit New Claim</h2>

    <form asp-action="CreateClaim" method="post">
        @Html.AntiForgeryToken()

        <div class="form-group mb-3">
            <label asp-for="LecturerId" class="form-label">Lecturer</label>
            <select asp-for="LecturerId" asp-items="@lecturersList" class="form-control" required>
                <option value="">-- Select Lecturer --</option>
            </select>
            <span asp-validation-for="LecturerId" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Month" class="form-label">Month</label>
            <input asp-for="Month" class="form-control" type="number" min="1" max="12" required />
            <span asp-validation-for="Month" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Year" class="form-label">Year</label>
            <input asp-for="Year" class="form-control" type="number" min="2020" max="2030" required />
            <span asp-validation-for="Year" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="TotalHours" class="form-label">Total Hours</label>
            <input asp-for="TotalHours" class="form-control" type="number" step="0.01" required />
            <span asp-validation-for="TotalHours" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Notes" class="form-label">Notes</label>
            <textarea asp-for="Notes" class="form-control"></textarea>
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary mt-3">Submit Claim</button>
        <a asp-action="Dashboard" class="btn btn-secondary mt-3">Back</a>
    </form>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mt-3">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger mt-3">@TempData["ErrorMessage"]</div>
    }
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}