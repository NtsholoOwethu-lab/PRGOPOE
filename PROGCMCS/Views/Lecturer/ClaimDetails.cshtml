@model PROGCMCS.Models.MonthlyClaim
@{
    ViewData["Title"] = "Claim Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="fas fa-file-invoice-dollar me-2"></i>Claim Details</h4>
                    <span class="badge @(Model.Status switch {
                        ClaimStatus.Draft => "bg-secondary",
                        ClaimStatus.Submitted => "bg-primary",
                        ClaimStatus.Verify => "bg-warning",
                        ClaimStatus.Approved => "bg-success",
                        ClaimStatus.Rejected => "bg-danger",
                        ClaimStatus.Paid => "bg-info",
                        _ => "bg-secondary"
                    })">@Model.Status</span>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6>Claim Information</h6>
                            <table class="table table-sm">
                                <tr>
                                    <th>Period:</th>
                                    <td>@Model.Month/@Model.Year</td>
                                </tr>
                                <tr>
                                    <th>Hours Worked:</th>
                                    <td>@Model.TotalHours.ToString("F1")</td>
                                </tr>
                                <tr>
                                    <th>Hourly Rate:</th>
                                    <td>@Model.HourlyRate.ToString("C")</td>
                                </tr>
                                <tr>
                                    <th>Total Amount:</th>
                                    <td class="fw-bold">@Model.TotalAmount.ToString("C")</td>
                                </tr>
                                <tr>
                                    <th>Submitted:</th>
                                    <td>@Model.SubmissionDate.ToString("yyyy-MM-dd HH:mm")</td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <h6>Approval Progress</h6>
                            @if (Model.ClaimApprovals != null && Model.ClaimApprovals.Any())
                            {
                                <div class="timeline">
                                    @foreach (var approval in Model.ClaimApprovals.OrderBy(a => a.ApprovalDate))
                                    {
                                        <div class="timeline-item mb-3">
                                            <div class="d-flex">
                                                <div class="timeline-badge @(approval.IsApproved ? "bg-success" : "bg-danger") me-3">
                                                    <i class="fas @(approval.IsApproved ? "fa-check" : "fa-times")"></i>
                                                </div>
                                                <div class="timeline-content">
                                                    @if (!string.IsNullOrEmpty(approval.ApproverRole))
                                                    {
                                                        <strong>@approval.ApproverRole</strong>
                                                    }
                                                    <small class="text-muted d-block">@approval.ApprovalDate.ToString("yyyy-MM-dd HH:mm")</small>
                                                    <p class="mb-1">@(approval.IsApproved ? "Approved" : "Rejected")</p>
                                                    @if (!string.IsNullOrEmpty(approval.Notes))
                                                    {
                                                        <small class="text-muted">@approval.Notes</small>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">No approvals yet. Claim is pending review.</p>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="row mt-3">
                            <div class="col-12">
                                <h6>Your Notes</h6>
                                <div class="alert alert-light">
                                    @Model.Notes
                                </div>
                            </div>
                        </div>
                    }

                    <div class="row mt-4">
                        <div class="col-12">
                            <a asp-action="Dashboard" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i>Back to Claims
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .timeline-badge {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        flex-shrink: 0;
    }
</style>