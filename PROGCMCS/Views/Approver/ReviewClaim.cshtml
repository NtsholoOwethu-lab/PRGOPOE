@model PROGCMCS.Models.MonthlyClaim
@{
    ViewData["Title"] = "Review Claim";
    var userRole = ViewBag.UserRole as string ?? "Approver";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0"><i class="fas fa-search me-2"></i>Review Claim</h4>
                </div>
                <div class="card-body">
                    <!-- Claim Information -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6>Claim Information</h6>
                            <table class="table table-sm table-bordered">
                                <tr>
                                    <th>Lecturer:</th>
                                    <td>@Model.Lecturer?.FirstName @Model.Lecturer?.LastName</td>
                                </tr>
                                <tr>
                                    <th>Period:</th>
                                    <td>@Model.Month/@Model.Year</td>
                                </tr>
                                <tr>
                                    <th>Hours Worked:</th>
                                    <td>@Model.TotalHours.ToString("F1")</td>
                                </tr>
                                <tr>
                                    <th>Hourly Rate:</th>
                                    <td>@Model.HourlyRate.ToString("C")</td>
                                </tr>
                                <tr>
                                    <th>Total Amount:</th>
                                    <td class="fw-bold">@Model.TotalAmount.ToString("C")</td>
                                </tr>
                                <tr>
                                    <th>Submitted:</th>
                                    <td>@Model.SubmissionDate.ToString("yyyy-MM-dd HH:mm")</td>
                                </tr>
                                <tr>
                                    <th>Current Status:</th>
                                    <td>
                                        <span class="badge @(Model.Status switch {
                                            ClaimStatus.Draft => "bg-secondary",
                                            ClaimStatus.Submitted => "bg-primary",
                                            ClaimStatus.Verify => "bg-warning",
                                            ClaimStatus.Approved => "bg-success",
                                            ClaimStatus.Rejected => "bg-danger",
                                            ClaimStatus.Paid => "bg-info",
                                            _ => "bg-secondary"
                                        })">@Model.Status</span>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        
                        <div class="col-md-6">
                            <h6>Approval History</h6>
                            @if (Model.ClaimApprovals != null && Model.ClaimApprovals.Any())
                            {
                                <div class="list-group">
                                    @foreach (var approval in Model.ClaimApprovals.OrderBy(a => a.ApprovalDate))
                                    {
                                        <div class="list-group-item">
                                            <div class="d-flex w-100 justify-content-between">
                                                <h6 class="mb-1">
                                                    <i class="fas @(approval.IsApproved ? "fa-check text-success" : "fa-times text-danger") me-2"></i>
                                                    @(approval.IsApproved ? "Approved" : "Rejected") by @approval.ApproverRole
                                                </h6>
                                                <small>@approval.ApprovalDate.ToString("yyyy-MM-dd")</small>
                                            </div>
                                            @if (!string.IsNullOrEmpty(approval.Notes))
                                            {
                                                <p class="mb-1 small">@approval.Notes</p>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">No previous approvals.</p>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6>Lecturer Notes</h6>
                                <div class="alert alert-light">
                                    @Model.Notes
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Approval Form -->
                    <div class="row">
                        <div class="col-12">
                            <h6>Your Decision</h6>
                            <form method="post" id="approvalForm">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="claimId" value="@Model.ClaimId" />
                                
                                <div class="form-group mb-3">
                                    <label for="notes" class="form-label">Notes (Optional):</label>
                                    <textarea name="notes" class="form-control" rows="3" 
                                              placeholder="Add any notes about your decision..."></textarea>
                                </div>

                                <div class="d-flex gap-2">
                                    <button type="submit" formaction="@Url.Action("ApproveClaim", "Verify")" 
                                            class="btn btn-success flex-fill">
                                        <i class="fas fa-check me-1"></i>Approve Claim
                                    </button>
                                    <button type="submit" formaction="@Url.Action("RejectClaim", "Verify")" 
                                            class="btn btn-danger flex-fill">
                                        <i class="fas fa-times me-1"></i>Reject Claim
                                    </button>
                                    <a href="@Url.Action("Dashboard", "Verify")" class="btn btn-secondary">
                                        <i class="fas fa-arrow-left me-1"></i>Back
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Add confirmation for actions
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('approvalForm');
            const approveBtn = form.querySelector('button[formaction*="ApproveClaim"]');
            const rejectBtn = form.querySelector('button[formaction*="RejectClaim"]');
            
            approveBtn.addEventListener('click', function(e) {
                if (!confirm('Are you sure you want to approve this claim?')) {
                    e.preventDefault();
                }
            });
            
            rejectBtn.addEventListener('click', function(e) {
                if (!confirm('Are you sure you want to reject this claim?')) {
                    e.preventDefault();
                }
            });
        });
    </script>
}