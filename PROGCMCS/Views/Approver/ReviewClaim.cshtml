@model PROGCMCS.Models.MonthlyClaim
@{
    ViewData["Title"] = "Review Claim";
}

<div class="row">
    <div class="col-12">
        <h2><i class="fas fa-search me-2"></i>Review Claim #@Model.ClaimId</h2>
        <p class="lead">Review the claim details and make an approval decision.</p>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0">Claim Details</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <strong>Lecturer:</strong> @Model.Lecturer.FirstName @Model.Lecturer.LastName<br>
                        <strong>Department:</strong> @Model.Lecturer.Department<br>
                        <strong>Email:</strong> @Model.Lecturer.Email<br>
                    </div>
                    <div class="col-md-6">
                        <strong>Period:</strong> @Model.Month/@Model.Year<br>
                        <strong>Hourly Rate:</strong> R @Model.Lecturer.HourlyRate.ToString("N2")<br>
                        <strong>Status:</strong>
                        <span class="claim-status status-@Model.Status.ToString().ToLower()">@Model.Status</span>
                    </div>
                </div>

                <hr>

                <div class="row">
                    <div class="col-md-6">
                        <strong>Hours Worked:</strong> @Model.TotalHours<br>
                        <strong>Total Amount:</strong> R @Model.TotalAmount.ToString("N2")<br>
                    </div>
                    <div class="col-md-6">
                        <strong>Submission Date:</strong> @Model.SubmissionDate.ToString("yyyy-MM-dd")<br>
                        <strong>Additional Notes:</strong><br>
                        <p class="text-muted">@(string.IsNullOrEmpty(Model.Notes) ? "None" : Model.Notes)</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Supporting Documents</h5>
            </div>
            <div class="card-body">
                @if (Model.SupportingDocuments.Any())
                {
                    <div class="list-group">
                        @foreach (var doc in Model.SupportingDocuments)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <i class="fas fa-file @(doc.FileType.Contains("pdf") ? "text-danger" :
                                                                                                                                        doc.FileType.Contains("word") ? "text-primary" :
                                                                                                                                        doc.FileType.Contains("excel") ? "text-success" :
                                                                                                                                        doc.FileType.Contains("image") ? "text-warning" : "text-secondary") me-2"></i>
                            @doc.FileName
                            <small class="text-muted d-block">
                                Uploaded: @doc.UploadDate.ToString("yyyy-MM-dd") |
                                Size: @((doc.FileSize / 1024 / 1024).ToString("0.00")) MB
                            </small>
                        </div>
                        <a href="@Url.Action("DownloadDocument", "Lecturer", new { id = doc.DocumentId })"
                           class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-download"></i> Download
                        </a>
                    </div>
                                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">No supporting documents uploaded.</p>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Approval Actions</h5>
            </div>
            <div class="card-body">
                <form method="post" action="@Url.Action("ApproveClaim")" class="mb-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="claimId" value="@Model.ClaimId" />
                    <input type="hidden" name="approverType" value="@ApproverType.ProgrammeCoordinator" />

                    <div class="mb-3">
                        <label for="approveComments" class="form-label">Comments (Optional):</label>
                        <textarea class="form-control" id="approveComments" name="comments" rows="3"
                                  placeholder="Add any comments for the lecturer..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-success w-100">
                        <i class="fas fa-check me-2"></i>Approve Claim
                    </button>
                </form>

                <form method="post" action="@Url.Action("RejectClaim")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="claimId" value="@Model.ClaimId" />
                    <input type="hidden" name="approverType" value="@ApproverType.ProgrammeCoordinator" />

                    <div class="mb-3">
                        <label for="rejectComments" class="form-label">Rejection Reason *:</label>
                        <textarea class="form-control" id="rejectComments" name="comments" rows="3"
                                  placeholder="Please provide a reason for rejection..." required></textarea>
                    </div>

                    <button type="submit" class="btn btn-danger w-100" onclick="return confirm('Are you sure you want to reject this claim?')">
                        <i class="fas fa-times me-2"></i>Reject Claim
                    </button>
                </form>
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header">
                <h5 class="card-title mb-0">Approval History</h5>
            </div>
            <div class="card-body">
                @if (Model.ClaimApprovals.Any())
                {
                    foreach (var approval in Model.ClaimApprovals.OrderBy(a => a.ApprovalDate))
                    {
                        <div class="mb-3">
                            <strong>@approval.ApproverType</strong><br>
                            <span class="@(approval.Decision == true ? "text-success" : "text-danger")">
                                @(approval.Decision == true ? "Approved" : "Rejected")
                            </span>
                            on @approval.ApprovalDate?.ToString("yyyy-MM-dd")<br>
                            @if (!string.IsNullOrEmpty(approval.Comments))
                            {
                                <small class="text-muted">"@approval.Comments"</small>
                            }
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">No approval history yet.</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a href="@Url.Action("Dashboard")" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
    </a>
</div>