@{
    ViewData["Title"] = "Automation";
}

<div class="container mt-4">
    <h2>Automation</h2>

    <div class="mb-3">
        <form asp-action="RunAutomation" method="post">
            @Html.AntiForgeryToken()
            <button class="btn btn-primary">Run Automation Rules</button>
        </form>
    </div>

    <div class="mb-3">
        <a asp-action="DownloadApprovedClaimsCsv" class="btn btn-outline-success">Download Approved Claims (CSV)</a>
    </div>



    <p class="text-muted">Status messages appear in the top-right as TempData alerts.</p>
</div>
