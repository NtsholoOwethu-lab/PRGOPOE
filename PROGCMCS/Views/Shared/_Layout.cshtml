@using Microsoft.AspNetCore.Antiforgery
@using System.Security.Claims
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CMCS</title>

    <!-- Antiforgery token for JS -->
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(HttpContextAccessor.HttpContext).RequestToken" />

    <!-- Bootstrap CSS (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">

    <!-- Font Awesome (CDN) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous" />

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        /* small helper styles used across pages */
        .claim-status {
            padding: .25rem .5rem;
            border-radius: .35rem;
            font-weight: 600;
        }

        .status-draft {
            background: #f0f0f0;
            color: #333;
        }

        .status-submitted {
            background: #0d6efd;
            color: white;
        }

        .status-underreview {
            background: #ffc107;
            color: #222;
        }

        .status-approved {
            background: #198754;
            color: white;
        }

        .status-rejected {
            background: #dc3545;
            color: white;
        }

        footer.site-footer {
            padding: 2rem 0;
            background: #f8f9fa;
            margin-top: 3rem;
        }

        .navbar-nav .nav-link.active {
            font-weight: bold;
            background: rgba(255,255,255,0.1);
            border-radius: 0.25rem;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark" style="background:#1070f4;">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="@Url.Action("Index", "Home")">
                <i class="fas fa-file-invoice-dollar me-2"></i>
                <strong>CMCS</strong>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <!-- Navigation Menu -->
                <ul class="navbar-nav me-auto">
                    <!-- Common Home link for all authenticated users -->
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                               href="@Url.Action("Index", "Home")">
                                <i class="fas fa-home me-1"></i>Home
                            </a>
                        </li>
                    }

                    <!-- Manager Navigation -->
                    @if (User.IsInRole("Manager"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Verify" ? "active" : "")"
                               href="@Url.Action("Dashboard", "Verify")">
                                <i class="fas fa-tasks me-1"></i>Pending Claims
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" ? "active" : "")"
                               href="@Url.Action("Index", "Report")">
                                <i class="fas fa-chart-bar me-1"></i>Reports
                            </a>
                        </li>
                    }

                    <!-- HR Navigation -->
                    @if (User.IsInRole("HR"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "HR" && ViewContext.RouteData.Values["action"]?.ToString() == "Workers" ? "active" : "")"
                               href="@Url.Action("Workers", "HR")">
                                <i class="fas fa-users me-1"></i>All Workers
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "HR" && ViewContext.RouteData.Values["action"]?.ToString() == "AddWorker" ? "active" : "")"
                               href="@Url.Action("AddWorker", "HR")">
                                <i class="fas fa-user-plus me-1"></i>Add Worker
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Automation" ? "active" : "")"
                               href="@Url.Action("Index", "Automation")">
                                <i class="fas fa-file-alt me-1"></i>Reports
                            </a>
                        </li>
                    }

                    <!-- Coordinator Navigation -->
                    @if (User.IsInRole("Coordinator"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Automation" ? "active" : "")"
                               href="@Url.Action("Index", "Automation")">
                                <i class="fas fa-cogs me-1"></i>Automation
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Coordinator" ? "active" : "")"
                               href="@Url.Action("Dashboard", "Coordinator")">
                                <i class="fas fa-eye me-1"></i>View Claims
                            </a>
                        </li>
                    }

                    <!-- Lecturer Navigation -->
                    @if (User.IsInRole("Lecturer"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "CreateClaim" ? "active" : "")"
                               href="@Url.Action("CreateClaim", "Lecturer")">
                                <i class="fas fa-plus-circle me-1"></i>Submit New Claim
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")"
                               href="@Url.Action("Dashboard", "Lecturer")">
                                <i class="fas fa-list-alt me-1"></i>My Claims
                            </a>
                        </li>
                    }
                </ul>

                <!-- User Info and Logout -->
                <div class="navbar-nav align-items-center">
                    @{
                        var user = HttpContextAccessor.HttpContext?.User;
                        var isAuth = user?.Identity?.IsAuthenticated ?? false;
                        var name = user?.FindFirst(ClaimTypes.Name)?.Value ?? user?.Identity?.Name ?? "";
                        var role = user?.FindFirst(ClaimTypes.Role)?.Value ?? "";
                        var email = user?.FindFirst(ClaimTypes.Email)?.Value ?? "";
                    }

                    @if (isAuth)
                    {
                        <div class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-user-circle me-1"></i>
                                @(string.IsNullOrEmpty(name) ? email.Split('@')[0] : name)
                                <small class="text-light">(@role)</small>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><span class="dropdown-item-text">@email</span></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <!-- FIXED: Use Identity's logout instead of custom Account controller -->
                                    <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                        <button type="submit" class="dropdown-item">
                                            <i class="fas fa-sign-out-alt me-1"></i>Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="nav-link text-white" href="@Url.Page("/Account/Login", new { area = "Identity" })">
                            <i class="fas fa-sign-in-alt me-1"></i>Login
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main class="container my-4">
        <!-- TempData alerts -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ModelErrors"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong>Validation errors:</strong>
                <div>@TempData["ModelErrors"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container text-center">
            <small>© @DateTime.Now.Year Contract Monthly Claim System. All rights reserved.</small>
        </div>
    </footer>

    <!-- Scripts: Bootstrap & dependencies (CDN) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>

    <!-- Optional: site-wide script -->
    <script src="~/js/site.js"></script>

    <!-- Make CSRF token available via JS global -->
    <script>
        window.CMCS = window.CMCS || {};
        const csrfMeta = document.querySelector('meta[name="csrf-token"]');
        window.CMCS.csrfToken = csrfMeta ? csrfMeta.getAttribute('content') : '';
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>