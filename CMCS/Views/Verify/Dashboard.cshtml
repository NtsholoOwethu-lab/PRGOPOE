@model List<CMCS.Models.MonthlyClaim>
@{
    ViewData["Title"] = "Verifier Dashboard";
}

<div class="row mb-3">
    <div class="col-12">
        <h2><i class="fas fa-check-circle me-2"></i>Verifier Dashboard</h2>
        <p class="lead">Review and verify claims submitted by lecturers before sending for approval.</p>
    </div>
</div>
<div class="card mb-3">
    <div class="card-header">
        <strong>Verification Guidelines</strong>
    </div>
    <div class="card-body">
        <ul class="mb-0">
            <li>Hourly rate must be between <strong>R 50</strong> and <strong>R 300</strong>.</li>
            <li>Total hours per claim must be between <strong>2</strong> and <strong>10</strong> hours.</li>
            <li>Claim period must not be in the future and must be within the last <strong>12 months</strong>.</li>
            <li>Claims that violate these rules are automatically declined with a comment explaining the reason.</li>
        </ul>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="card shadow-sm">
    <div class="card-header bg-light">
        <h5 class="card-title mb-0"><i class="fas fa-clipboard-list me-2"></i>Claims Pending Verification</h5>
    </div>
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Lecturer</th>
                            <th>Department</th>
                            <th>Period</th>
                            <th>Hours</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Submission Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var claim in Model)
                        {
                            <tr>
                                <td>@claim.ClaimId</td>
                                <td>@claim.Lecturer?.FirstName @claim.Lecturer?.LastName</td>
                                <td>@claim.Lecturer?.Department</td>
                                <td>@claim.Month/@claim.Year</td>
                                <td>@claim.TotalHours</td>
                                <td>R @claim.TotalAmount.ToString("N2")</td>
                                <td><span class="badge bg-warning text-dark">@claim.Status</span></td>
                                <td>@claim.SubmissionDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <a asp-action="ReviewClaim" asp-route-id="@claim.ClaimId" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-eye"></i> Review
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-4">
                <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                <h5>No pending claims</h5>
                <p class="text-muted">All submitted claims have been verified.</p>
            </div>
        }
    </div>
</div>
