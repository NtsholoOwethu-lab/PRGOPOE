@{
    ViewData["Title"] = "About";
}

<div class="row">
    <div class="col-12">
        <h2>About CMCS</h2>
        <p class="lead">Learn more about the Contract Monthly Claim System.</p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">System Overview</h5>
        <p>The Contract Monthly Claim System (CMCS) is designed to streamline the process of submitting and approving monthly claims for Independent Contractor (IC) lecturers.</p>

        <h6>Key Features:</h6>
        <ul>
            <li>Easy claim submission for lecturers</li>
            <li>Automated calculations based on hours worked and hourly rates</li>
            <li>Secure document upload and management</li>
            <li>Multi-level approval workflow</li>
            <li>Real-time status tracking</li>
        </ul>
    </div>
</div>