@model IEnumerable<CMCS.Models.SupportingDocument>
@{
    ViewData["Title"] = "My Documents";
}

<div class="container mt-4">
    <h2 class="mb-4">Uploaded Documents</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You have not uploaded any supporting documents yet.
        </div>
    }
    else
    {
        <table class="table table-bordered table-striped align-middle">
            <thead class="table-primary">
                <tr>
                    <th>File Name</th>
                    <th>Uploaded Date</th>
                    <th>Claim ID</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doc in Model)
                {
                    <tr>
                        <td>@doc.FileName</td>
                        <td>@doc.UploadDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@doc.ClaimId</td>
                        <td>
                            <a class="btn btn-sm btn-success"
                               href="@Url.Action("DownloadDocument", "Lecturer", new { id = doc.DocumentId })">
                                <i class="fas fa-download"></i> Download
                            </a>
                            <button class="btn btn-sm btn-danger"
                                    onclick="deleteDocument(@doc.DocumentId, '@doc.FileName')">
                                <i class="fas fa-trash-alt"></i> Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@section Scripts {
    <script>
        function deleteDocument(documentId, fileName) {
            if (confirm('Are you sure you want to delete "' + fileName + '"? This action cannot be undone.')) {
                const tokenMeta = document.querySelector('meta[name="csrf-token"]');
                const token = tokenMeta ? tokenMeta.getAttribute('content') : '';

                fetch('@Url.Action("DeleteDocument", "Lecturer")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ documentId: documentId })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert(data.message);
                        location.reload();
                    } else {
                        alert(data.message);
                    }
                })
                .catch(error => {
                    alert('An error occurred while deleting the document.');
                    console.error('Error:', error);
                });
            }
        }
    </script>
}
