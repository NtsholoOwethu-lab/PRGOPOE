@model IEnumerable<CMCS.Models.Lecturer>

@{
    ViewData["Title"] = "Lecturer Dashboard";
}

<div class="container mt-4">
    <h2 class="mb-4">Lecturer Dashboard</h2>

    <div class="mb-3">
        <a asp-action="AddLecturer" class="btn btn-success me-2">Add New Lecturer</a>
        <a asp-action="CreateClaim" class="btn btn-primary">Submit New Claim</a>
    </div>

    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Lecturer</th>
                <th>Email</th>
                <th>Hourly Rate</th>
                <th>Latest Claim</th>
                <th>Total Amount</th>
                <th>Status</th>
                <th>Date Submitted</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var lecturer in Model)
            {
                var latestClaim = lecturer.MonthlyClaims?.OrderByDescending(c => c.SubmissionDate).FirstOrDefault();

                <tr>
                    <td>@lecturer.FirstName @lecturer.LastName</td>
                    <td>@lecturer.Email</td>
                    <td>R @lecturer.HourlyRate.ToString("N2")</td>

                    @if (latestClaim != null)
                    {
                        <td>@latestClaim.Month / @latestClaim.Year</td>
                        <td>R @latestClaim.TotalAmount.ToString("N2")</td>
                        <td>
                            @{
                                string badgeClass = latestClaim.Status switch
                                {
                                    CMCS.Models.ClaimStatus.Submitted => "bg-primary",
                                   
                                    CMCS.Models.ClaimStatus.Approved => "bg-success",
                                    CMCS.Models.ClaimStatus.Rejected => "bg-danger",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass">@latestClaim.Status</span>
                        </td>
                        <td>@latestClaim.SubmissionDate.ToShortDateString()</td>
                    }
                    else
                    {
                        <td colspan="3"><em>No claims submitted yet</em></td>
                    }

                    <td>
                        <a asp-action="Details" asp-route-id="@lecturer.LecturerId" class="btn btn-outline-primary btn-sm">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mt-3">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger mt-3">@TempData["ErrorMessage"]</div>
    }
</div>
