@model CMCS.Models.MonthlyClaim
@{
    ViewData["Title"] = "Submit New Claim";
}

<div class="row">
    <div class="col-12">
        <h2><i class="fas fa-plus-circle me-2"></i>Submit New Monthly Claim</h2>
        <p class="lead">Complete the form below to submit your monthly claim.</p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form method="post" enctype="multipart/form-data" id="claimForm">
            @Html.AntiForgeryToken()

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label for="Month" class="form-label">Month *</label>
                        <select class="form-select" id="Month" name="Month" required>
                            <option value="">Select Month</option>
                            @for (int i = 1; i <= 12; i++)
                            {
                                <option value="@i">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                            }
                        </select>
                        <span class="text-danger" id="monthError"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label for="Year" class="form-label">Year *</label>
                        <select class="form-select" id="Year" name="Year" required>
                            <option value="">Select Year</option>
                            @for (int i = DateTime.Now.Year - 1; i <= DateTime.Now.Year + 1; i++)
                            {
                                <option value="@i">@i</option>
                            }
                        </select>
                        <span class="text-danger" id="yearError"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label for="TotalHours" class="form-label">Total Hours Worked *</label>
                        <input type="number" class="form-control" id="TotalHours" name="TotalHours"
                               min="0" max="200" step="0.5" required>
                        <span class="text-danger" id="hoursError"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Hourly Rate</label>
                        <input type="text" class="form-control" value="R @ViewBag.HourlyRate.ToString("N2")" readonly>
                        <small class="form-text text-muted">Predefined hourly rate</small>
                    </div>
                </div>
            </div>

            <!-- Hidden bound field for model binding and server -->
            <input asp-for="TotalAmount" type="hidden" id="TotalAmount" name="TotalAmount" />

            <div class="mb-3">
                <label for="TotalAmountDisplay" class="form-label">Total Amount</label>
                <input type="text" class="form-control" id="TotalAmountDisplay" readonly value="R 0.00">
                <small class="form-text text-muted">Calculated automatically based on hours and rate</small>
            </div>

            <div class="mb-3">
                <label for="Notes" class="form-label">Additional Notes (Optional)</label>
                <textarea class="form-control" id="Notes" name="Notes" rows="3"
                          placeholder="Any additional information about this claim..."></textarea>
            </div>

            <div class="mb-4">
                <label class="form-label">Supporting Documents</label>
                <div class="border rounded p-3 bg-light" id="uploadArea">
                    <div class="text-center" id="uploadPlaceholder">
                        <i class="fas fa-cloud-upload-alt fa-2x text-muted mb-2"></i>
                        <p class="text-muted">Drag and drop files here or click to browse</p>
                        <input type="file" id="fileInput" name="files" multiple
                               accept=".pdf,.docx,.xlsx,.jpg,.jpeg,.png" style="display: none;">
                        <button type="button" class="btn btn-outline-primary" onclick="document.getElementById('fileInput').click()">
                            <i class="fas fa-plus me-2"></i>Add Documents
                        </button>
                        <small class="form-text d-block mt-2">
                            Supported formats: PDF, DOCX, XLSX, JPEG, PNG (Max 10MB per file)
                        </small>
                    </div>
                    <div id="fileList" class="mt-3" style="display: none;">
                        <h6>Selected Files:</h6>
                        <ul class="list-group" id="selectedFilesList"></ul>
                    </div>
                </div>
                <span class="text-danger" id="filesError"></span>
            </div>

            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <a href="@Url.Action("Dashboard")" class="btn btn-outline-secondary me-md-2">Cancel</a>
                <button type="submit" class="btn btn-success" id="submitBtn">
                    <i class="fas fa-paper-plane me-2"></i>Submit Claim
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const hoursInput = document.getElementById('TotalHours');
            const totalAmountHidden = document.getElementById('TotalAmount'); // hidden bound field
            const totalAmountDisplay = document.getElementById('TotalAmountDisplay'); // visible display
            const fileInput = document.getElementById('fileInput');
            const uploadArea = document.getElementById('uploadArea');
            const uploadPlaceholder = document.getElementById('uploadPlaceholder');
            const fileList = document.getElementById('fileList');
            const selectedFilesList = document.getElementById('selectedFilesList');
            const hourlyRate = @ViewBag.HourlyRate;
            const maxFileSize = 10 * 1024 * 1024; // 10MB in bytes

            let selectedFiles = [];

            function calculateTotal() {
                const hours = parseFloat(hoursInput.value) || 0;
                const total = hours * hourlyRate;
                // set numeric value for model binding
                totalAmountHidden.value = total.toFixed(2);
                // set display for the user
                totalAmountDisplay.value = 'R ' + total.toFixed(2);
            }

            function updateFileList() {
                selectedFilesList.innerHTML = '';
                selectedFiles.forEach((file, index) => {
                    const listItem = document.createElement('li');
                    listItem.className = 'list-group-item d-flex justify-content-between align-items-center';
                    listItem.innerHTML = `
                        <div>
                            <i class="fas fa-file me-2"></i>${file.name}
                            <small class="text-muted d-block">(${(file.size / 1024 / 1024).toFixed(2)} MB)</small>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeFile(${index})">
                            <i class="fas fa-times"></i>
                        </button>
                    `;
                    selectedFilesList.appendChild(listItem);
                });

                if (selectedFiles.length > 0) {
                    fileList.style.display = 'block';
                    uploadPlaceholder.style.display = 'none';
                } else {
                    fileList.style.display = 'none';
                    uploadPlaceholder.style.display = 'block';
                }
            }

            function validateFiles(files) {
                const allowedExtensions = ['.pdf', '.docx', '.xlsx', '.jpg', '.jpeg', '.png'];

                for (let file of files) {
                    const extension = file.name.toLowerCase().substring(file.name.lastIndexOf('.'));

                    if (!allowedExtensions.includes(extension)) {
                        alert(`File ${file.name} has an unsupported format. Allowed formats: PDF, DOCX, XLSX, JPG, JPEG, PNG.`);
                        return false;
                    }

                    if (file.size > maxFileSize) {
                        alert(`File ${file.name} exceeds the maximum size limit of 10MB.`);
                        return false;
                    }
                }
                return true;
            }

            window.removeFile = function(index) {
                selectedFiles.splice(index, 1);
                updateFileList();

                // Update the file input
                const dataTransfer = new DataTransfer();
                selectedFiles.forEach(file => dataTransfer.items.add(file));
                fileInput.files = dataTransfer.files;
            };

            hoursInput.addEventListener('input', calculateTotal);
            calculateTotal(); // Initial calculation

            fileInput.addEventListener('change', function(e) {
                const files = Array.from(e.target.files);

                if (validateFiles(files)) {
                    selectedFiles = selectedFiles.concat(files);
                    updateFileList();

                    // Update the file input with all selected files
                    const dataTransfer = new DataTransfer();
                    selectedFiles.forEach(file => dataTransfer.items.add(file));
                    fileInput.files = dataTransfer.files;
                } else {
                    // Reset the input if validation fails
                    fileInput.value = '';
                }
            });

            // Drag and drop functionality
            uploadArea.addEventListener('dragover', function(e) {
                e.preventDefault();
                uploadArea.classList.add('bg-primary', 'text-white');
            });

            uploadArea.addEventListener('dragleave', function(e) {
                e.preventDefault();
                uploadArea.classList.remove('bg-primary', 'text-white');
            });

            uploadArea.addEventListener('drop', function(e) {
                e.preventDefault();
                uploadArea.classList.remove('bg-primary', 'text-white');

                const files = Array.from(e.dataTransfer.files);
                if (validateFiles(files)) {
                    selectedFiles = selectedFiles.concat(files);
                    updateFileList();

                    // Update the file input
                    const dataTransfer = new DataTransfer();
                    selectedFiles.forEach(file => dataTransfer.items.add(file));
                    fileInput.files = dataTransfer.files;
                }
            });

            // Form validation
            document.getElementById('claimForm').addEventListener('submit', function(e) {
                let isValid = true;

                // Clear previous errors
                document.querySelectorAll('.text-danger').forEach(el => el.textContent = '');

                // Validate required fields
                if (!document.getElementById('Month').value) {
                    document.getElementById('monthError').textContent = 'Month is required.';
                    isValid = false;
                }

                if (!document.getElementById('Year').value) {
                    document.getElementById('yearError').textContent = 'Year is required.';
                    isValid = false;
                }

                if (!hoursInput.value || parseFloat(hoursInput.value) <= 0) {
                    document.getElementById('hoursError').textContent = 'Please enter valid hours worked.';
                    isValid = false;
                }

                if (!isValid) {
                    e.preventDefault();
                    alert('Please fill in all required fields correctly.');
                }
            });
        });
    </script>
}
