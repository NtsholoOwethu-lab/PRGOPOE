@using Microsoft.AspNetCore.Antiforgery
@using System.Security.Claims
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CMCS</title>

    <!-- Antiforgery token for JS -->
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(HttpContextAccessor.HttpContext).RequestToken" />

    <!-- Bootstrap CSS (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">

    <!-- Font Awesome (CDN) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous" />

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        /* small helper styles used across pages */
        .claim-status {
            padding: .25rem .5rem;
            border-radius: .35rem;
            font-weight: 600;
        }

        .status-draft {
            background: #f0f0f0;
            color: #333;
        }

        .status-submitted {
            background: #0d6efd;
            color: white;
        }

        .status-underreview {
            background: #ffc107;
            color: #222;
        }

        .status-approved {
            background: #198754;
            color: white;
        }

        .status-rejected {
            background: #dc3545;
            color: white;
        }

        footer.site-footer {
            padding: 2rem 0;
            background: #f8f9fa;
            margin-top: 3rem;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark" style="background:#1070f4;">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="@Url.Action("Index", "Home")">
                <i class="fas fa-file-invoice-dollar me-2"></i>
                <strong>CMCS</strong>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">


                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                           href="@Url.Action("Index", "Home")">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Dashboard", "Lecturer")">Lecturer Portal</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Dashboard", "Verify")">Verify Portal</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Dashboard", "Approver")">Approver Portal</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Automation")">Automation / HR Reports</a>
                    </li>

                </ul>

                <div class="d-flex align-items-center">
                    @{
                        var user = HttpContextAccessor.HttpContext?.User;
                        var isAuth = user?.Identity?.IsAuthenticated ?? false;
                        var name = user?.FindFirst(ClaimTypes.Name)?.Value ?? "";
                        var role = user?.FindFirst(ClaimTypes.Role)?.Value ?? "";
                    }

                    @if (isAuth)
                    {
                        <span class="text-white me-2">Signed in as <strong>@(string.IsNullOrEmpty(name) ? "User" : name)</strong> <small class="text-light">(@role)</small></span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-light btn-sm" href="@Url.Action("Login", "Account")">Login</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main class="container my-4">
        <!-- TempData alerts -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ModelErrors"] != null)
        {
            <div class="alert alert-warning">
                <strong>Validation errors:</strong>
                <div>@TempData["ModelErrors"]</div>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container text-center">
            <small>© @DateTime.Now.Year Contract Monthly Claim System. All rights reserved.</small>
        </div>
    </footer>

    <!-- Scripts: Bootstrap & dependencies (CDN) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>

    <!-- Optional: site-wide script -->
    <script src="~/js/site.js"></script>

    <!-- Make CSRF token available via JS global -->
    <script>
        window.CMCS = window.CMCS || {};
        const csrfMeta = document.querySelector('meta[name="csrf-token"]');
        window.CMCS.csrfToken = csrfMeta ? csrfMeta.getAttribute('content') : '';
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
